{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>foreverworks/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Renovate version the CI job validates default.json and renovate.json with (npx --package renovate@<version>).",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["--package renovate@(?<currentValue>[0-9][^\\s]*)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate"
    }
  ]
}
